@model List<Media>
@{
    var users = (List<User>)ViewBag.Users;
    int? selectedUserId = ViewBag.SelectedUserId;
    ViewData["Title"] = "Quản lý YouTube Video";
}

<div class="page-header">
  <h1 class="page-title">Quản lý YouTube Video</h1>
</div>

<form method="get" action="/admin/youtube" class="card" style="margin-bottom: 1rem; display: flex; gap: 0.75rem; align-items: end; flex-wrap: wrap;">
  <div class="form-group u-fg-inline-220">
    <label class="form-label">Người dùng</label>
    <select name="userId" class="form-input">
      <option value="">Tất cả người dùng</option>
      @foreach (var user in users)
      {
        <option value="@user.Id" selected="@(selectedUserId == user.Id)">@user.Username</option>
      }
    </select>
  </div>
  <button type="submit" class="btn btn-primary fx-btn">Lọc</button>
  <a href="/admin/youtube" class="btn btn-secondary fx-soft">Xóa bộ lọc</a>
</form>

<div class="table-wrapper">
  @if (!Model.Any())
  {
    <div class="empty-state">
      <div class="u-empty-icon-lg">🎬</div>
      <p>Chưa có YouTube video nào.</p>
    </div>
  }
  else
  {
    <table class="table">
      <thead>
        <tr class="fx-list-row">
          <th>Video</th>
          <th>Link</th>
          <th>Người dùng</th>
          <th>Ngày thêm</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var video in Model)
        {
          <tr class="fx-list-row">
            <td>
              <div class="u-flex" style="gap:0.5rem;align-items:center;">
                <img src="@(video.ThumbnailUrl ?? "/images/video-placeholder.svg")" style="width:80px;height:45px;object-fit:cover;border-radius:6px;" onerror="this.src='/images/video-placeholder.svg';" alt="" />
                <span>@video.FileName</span>
              </div>
            </td>
            <td><a href="@video.FileUrl" target="_blank" style="max-width:300px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@video.FileUrl</a></td>
            <td><span class="badge badge-primary">@(video.User?.Username ?? "-")</span></td>
            <td class="text-muted text-sm">@VietnamTimeFormatter.FormatUtc(video.UploadedAt, "yyyy-MM-dd HH:mm")</td>
            <td>
              <div class="action-buttons">
                <a class="btn btn-sm btn-secondary" href="@video.FileUrl" target="_blank">Xem</a>
                <form method="post" action="/admin/youtube/delete" onsubmit="return confirm('Xóa YouTube video @video.FileName?')">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="mediaId" value="@video.Id" />
                  <button type="submit" class="btn btn-sm u-btn-danger-soft">Xóa</button>
                </form>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  }
</div>
