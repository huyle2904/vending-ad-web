@model List<Media>
@{
    ViewData["Title"] = "YouTube Video";
    const string youTubePlaceholder = "/images/video-placeholder.svg";
}

<div class="video-page youtube-page">
  <section class="video-overview">
    <form method="post" action="/portal/youtube/add" class="video-drop-area youtube-add-card" aria-label="Thêm video YouTube vào thư viện">
      @Html.AntiForgeryToken()
      <div class="upload-circle youtube-circle"><i class="bi bi-youtube"></i></div>
      <div class="video-drop-copy">
        <h3>Thêm link YouTube</h3>
        <div class="video-format-chips">
          <span>youtube.com/watch</span>
          <span>youtu.be</span>
          <span>Shorts</span>
          <span>Tự lấy thumbnail</span>
        </div>
        <div class="youtube-input-wrap">
          <input type="url" id="youtubeUrl" name="youtubeUrl" class="form-input" placeholder="https://www.youtube.com/watch?v=..." required />
        </div>
      </div>
      <div class="video-drop-actions youtube-add-actions">
        <button type="submit" class="video-select-btn"><i class="bi bi-plus-lg"></i>Thêm video</button>
      </div>
    </form>

    <div class="video-stat-actions video-metric-grid">
      <article class="video-metric-card youtube-metric-card">
        <span><i class="bi bi-youtube"></i></span>
        <div><strong>@Model.Count</strong><small>Tổng YouTube video</small></div>
      </article>
    </div>
  </section>

  <section class="video-library-card youtube-library-card">
    <header class="video-library-head">
      <div>
        <h2>Danh sách YouTube video (@Model.Count)</h2>
        <p>Các video YouTube đã thêm vào thư viện.</p>
      </div>
    </header>

    @if (!Model.Any())
    {
      <div class="empty-box video-empty-min">Chưa có YouTube video nào trong thư viện.</div>
    }
    else
    {
      <div class="video-list youtube-video-list">
          @foreach (var video in Model)
          {
            var thumbnailUrl = string.IsNullOrWhiteSpace(video.ThumbnailUrl) ? youTubePlaceholder : video.ThumbnailUrl;
            <article class="video-list-row fx-list-row youtube-list-row">
              <div class="col-media youtube-col-media">
                <div class="youtube-thumb-wrap">
                  <img src="@thumbnailUrl" onerror="this.onerror=null;this.src='@youTubePlaceholder';" alt="Thumbnail @video.FileName" />
                  <span class="youtube-play-badge"><i class="bi bi-play-fill"></i></span>
                </div>
                <div>
                  <strong title="@video.FileName">@video.FileName</strong>
                  <small><i class="bi bi-youtube"></i> YouTube video</small>
                </div>
              </div>
              <div class="video-row-meta"><strong>YouTube</strong><small>Nguồn</small></div>
              <div class="video-row-meta youtube-link-meta">
                <strong title="@video.FileUrl">@video.FileUrl</strong><small>Link</small>
              </div>
              <div class="video-row-meta"><strong>@VietnamTimeFormatter.FormatUtc(video.UploadedAt, "dd/MM/yyyy")</strong><small>Ngày thêm</small></div>
              <div class="col-actions">
                <a class="icon-btn" href="@video.FileUrl" target="_blank" rel="noopener noreferrer" title="Mở trong YouTube"><i class="bi bi-box-arrow-up-right"></i></a>
                <form method="post" action="/portal/youtube/delete" class="u-inline">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="mediaId" value="@video.Id" />
                  <button class="icon-btn danger-outline" type="submit" title="Xóa link YouTube" aria-label="Xóa @video.FileName" onclick="return confirm('Bạn có chắc muốn xóa link YouTube này?')"><i class="bi bi-trash3"></i></button>
                </form>
              </div>
            </article>
          }
      </div>
      <div class="video-list-foot">Hiển thị 1 đến @Model.Count của @Model.Count video</div>
    }
  </section>
</div>
